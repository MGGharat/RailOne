# RailOne Railway App Environment Variables
# Rename or copy to .env

PROJECT_NAME=RailOne
VERSION=1.0.0

# Security (JWT secret key - generate a secure random 32+ char token in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production-jwt-railone
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# For local SQLite development (zero setup):
DATABASE_URL=sqlite:///./railone.db

# For PostgreSQL production / Docker setup:
# DATABASE_URL=postgresql://rail_user:rail_password@postgres:5432/railone_db

# Redis Caching & Distributed Concurrency Lock
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# CORS Origins (comma-separated or list)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Demo Credentials (Development / Testing only)
# User: user@railone.demo / User@12345
# Admin: admin@railone.demo / Admin@12345
